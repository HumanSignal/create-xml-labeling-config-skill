# labeling-config-builder credentials — TEMPLATE.
#
# Copy this file to `.env` and fill in real values:
#
#   cp .env.example .env
#
# `.env` is gitignored; this file (`.env.example`) is tracked so new
# teammates know what to provision.

# ---- Label Studio (target instance for validation + push) ----
# Base URL of your Label Studio instance. For a local install this is
# almost always http://localhost:8080. For remote/enterprise instances,
# use the full URL (no trailing slash needed — the scripts strip it).
LABEL_STUDIO_URL=http://localhost:8080

# Personal API token from your Label Studio Account page:
#   Account & Settings -> Access Token -> Copy
#
# This is the same token you'd pass as `Authorization: Token <...>`
# when calling the LS REST API directly.
#
# Without this, server-side validation and the push step are skipped
# (you'll see warnings). Local structural validation still runs.
LABEL_STUDIO_API_KEY=replace_me
